# Env necessárias na Vercel (Settings > Environment Variables)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Obtenha em: https://tavily.com/
TAVILY_API_KEY=tvly-...

# Modelo Groq. Você pediu "qwen/qwen3.8-27b" que não existe na Groq.
# O equivalente oficial e estável é "qwen/qwen3-32b".
# Se a Groq lançar qwen3.8-27b, basta trocar aqui sem mexer no código.
GROQ_MODEL=qwen/qwen3-32b
